; Ironvow — Godot 4.3 port (engine project)
; Generated as the foundation port of the HTML5 game. Open in Godot 4.3+.

config_version=5

[application]

config/name="Ironvow"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/show_image=false

[autoload]

GameData="*res://scripts/GameData.gd"
GameSave="*res://scripts/GameSave.gd"
GameAudio="*res://scripts/GameAudio.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.082, 0.075, 0.059, 1)
